# Copy this file to .env and replace the placeholder secrets before starting Docker.
POSTGRES_DB=secure_ledger
POSTGRES_USER=secure_ledger
POSTGRES_PASSWORD=change-this-to-a-long-url-safe-password
JWT_SECRET=replace-with-a-long-random-secret

# Optional: set custom browser origins or use an external API URL.
CLIENT_ORIGINS=
VITE_API_URL=

# Optional: configure these if the application sends email.
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Optional: set these before running the system-account seed command.
SYSTEM_USER_EMAIL=
SYSTEM_USER_PASSWORD=
SYSTEM_INITIAL_CAPITAL=
